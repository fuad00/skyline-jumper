<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Game.uss" />
    <ui:VisualElement name="root" class="root">

        <!-- ===== in-game HUD ===== -->
        <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
            <ui:VisualElement name="minimap" class="minimap" picking-mode="Ignore" />
            <ui:VisualElement class="grow" picking-mode="Ignore" />
            <ui:VisualElement name="wind-panel" class="panel wind-panel" picking-mode="Ignore">
                <ui:VisualElement class="lcd wind-lcd" picking-mode="Ignore">
                    <ui:Label name="wind-label" class="wind-caption" text="ВЕТЕР" picking-mode="Ignore" />
                    <ui:VisualElement class="wind-track" picking-mode="Ignore">
                        <ui:VisualElement name="wind-fill" class="wind-fill" picking-mode="Ignore">
                            <ui:VisualElement name="wind-arrow" class="wind-arrow" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="time-panel" class="panel time-panel" picking-mode="Ignore">
                <ui:VisualElement name="clock-slot" class="clock-slot" picking-mode="Ignore" />
                <ui:VisualElement class="lcd time-lcd" picking-mode="Ignore">
                    <ui:Label name="hud-time" class="time-text" text="30,00" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="zoom" class="panel btn-square">
                <ui:VisualElement name="icon-zoom" class="icon icon--big" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="pause" class="panel btn-square">
                <ui:VisualElement name="icon-pause" class="icon icon--big" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>

        <ui:Label name="tutorial" class="tutorial" picking-mode="Ignore" />

        <!-- ===== main menu ===== -->
        <ui:VisualElement name="menu-screen" class="screen" picking-mode="Ignore">
            <ui:VisualElement class="logo" picking-mode="Ignore">
                <ui:Label name="logo-top" class="sticker sticker--small" text="Stickman." picking-mode="Ignore" />
                <ui:Label name="logo-bottom" class="sticker sticker--logo" text="jumper" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="menu-bar" class="bar" picking-mode="Ignore" />
            <!-- settings: like the original's Options, the same bar swaps its buttons -->
            <ui:VisualElement name="settings-bar" class="bar" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ===== stage select ===== -->
        <ui:VisualElement name="stage-screen" class="screen" picking-mode="Ignore">
            <ui:VisualElement class="heading" picking-mode="Ignore">
                <ui:Label name="stage-heading-small" class="sticker sticker--small" text="Выбери" picking-mode="Ignore" />
                <ui:Label name="stage-heading-big" class="sticker" text="этап" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="stage-cards" class="stage-cards" picking-mode="Ignore" />
            <ui:VisualElement name="stage-bar" class="bar" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ===== level select ===== -->
        <ui:VisualElement name="level-screen" class="screen" picking-mode="Ignore">
            <ui:VisualElement class="heading" picking-mode="Ignore">
                <ui:Label name="level-heading-small" class="sticker sticker--small" text="Выбери" picking-mode="Ignore" />
                <ui:Label name="level-heading-big" class="sticker" text="уровень" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="level-badge" class="stage-badge" picking-mode="Ignore" />
            <ui:VisualElement name="level-grid" class="level-grid" picking-mode="Ignore" />
            <ui:VisualElement name="level-bar" class="bar" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ===== pause ===== -->
        <ui:VisualElement name="pause-overlay" class="screen screen--dim" picking-mode="Ignore">
            <ui:VisualElement class="heading heading--center" picking-mode="Ignore">
                <ui:Label name="pause-title" class="sticker" text="пауза" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="pause-bar" class="bar" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ===== jump summary (original style: dark card + red points bar) ===== -->
        <ui:VisualElement name="summary" class="screen screen--dim" picking-mode="Ignore">
            <ui:VisualElement class="summary-card" picking-mode="Ignore">
                <ui:VisualElement class="summary-title" picking-mode="Ignore">
                    <ui:VisualElement name="summary-face" class="summary-face" picking-mode="Ignore" />
                    <ui:VisualElement picking-mode="Ignore">
                        <ui:Label name="summary-title-small" class="summary-title-small" text="отличный" picking-mode="Ignore" />
                        <ui:Label name="summary-title-big" class="summary-title-big" text="ПРЫЖОК" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="summary-level" class="summary-level" text="ЭТАП 1 — ПРЫЖОК 1" picking-mode="Ignore" />
                <ui:VisualElement class="summary-line" picking-mode="Ignore">
                    <ui:Label name="distance-label" class="summary-key" text="ДО ФЛАЖКА" picking-mode="Ignore" />
                    <ui:Label name="summary-distance" class="summary-value" text="0,00 м" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="summary-line" picking-mode="Ignore">
                    <ui:Label name="best-label" class="summary-key" text="ЛУЧШЕЕ" picking-mode="Ignore" />
                    <ui:Label name="summary-best" class="summary-value" text="0,00 м" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="stars" class="stars" picking-mode="Ignore">
                    <ui:VisualElement name="star-1" class="star" picking-mode="Ignore" />
                    <ui:VisualElement name="star-2" class="star" picking-mode="Ignore" />
                    <ui:VisualElement name="star-3" class="star" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="summary-record" class="summary-record" text="НОВЫЙ РЕКОРД!" picking-mode="Ignore" />
                <ui:VisualElement name="points-bar" class="points-bar" picking-mode="Ignore">
                    <ui:VisualElement picking-mode="Ignore">
                        <ui:Label name="points-small" class="points-small" text="всего" picking-mode="Ignore" />
                        <ui:Label name="points-big" class="points-big" text="ОЧКОВ" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="summary-points" class="points-value" text="0" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="summary-bar" class="bar" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ===== settings during play (from the pause or the summary) ===== -->
        <ui:VisualElement name="game-settings" class="screen screen--dim" picking-mode="Ignore">
            <ui:VisualElement class="heading heading--center" picking-mode="Ignore">
                <ui:Label name="game-settings-title" class="sticker" text="настройки" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="game-settings-bar" class="bar" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ===== dialog: «are you sure?» and the map builder stub (blocks touches underneath) ===== -->
        <ui:VisualElement name="dialog" class="screen screen--dim dialog">
            <ui:VisualElement name="dialog-card" class="dialog-card" picking-mode="Ignore">
                <ui:Label name="dialog-title" class="dialog-title" picking-mode="Ignore" />
                <ui:Label name="dialog-text" class="dialog-text" picking-mode="Ignore" />
                <ui:VisualElement name="dialog-bar" class="dialog-bar" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

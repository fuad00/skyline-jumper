<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Game.uss" />
    <ui:VisualElement name="root" class="root">

        <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
            <ui:VisualElement class="hud-row" picking-mode="Ignore">
                <ui:VisualElement class="pill" picking-mode="Ignore">
                    <ui:VisualElement name="icon-time" class="icon" picking-mode="Ignore" />
                    <ui:Label name="hud-time" class="pill-text" text="30,0" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="pill" picking-mode="Ignore">
                    <ui:VisualElement name="icon-wind" class="icon icon--wind" picking-mode="Ignore" />
                    <ui:Label name="hud-wind" class="pill-text" text="0" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="grow" picking-mode="Ignore" />
                <ui:Button name="zoom" class="btn-round">
                    <ui:VisualElement name="icon-zoom" class="icon icon--zoom" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="hint" class="hint" picking-mode="Ignore" />

        <ui:VisualElement name="summary" class="summary-backdrop" picking-mode="Ignore">
            <ui:VisualElement class="summary" picking-mode="Ignore">
                <ui:Label name="summary-title" class="summary-title" text="ОТЛИЧНО!" picking-mode="Ignore" />
                <ui:VisualElement name="stars" class="stars" picking-mode="Ignore">
                    <ui:VisualElement name="star-1" class="star" picking-mode="Ignore" />
                    <ui:VisualElement name="star-2" class="star star--mid" picking-mode="Ignore" />
                    <ui:VisualElement name="star-3" class="star" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="summary-line" picking-mode="Ignore">
                    <ui:Label name="distance-label" class="summary-key" text="До стрелки" picking-mode="Ignore" />
                    <ui:Label name="summary-distance" class="summary-value" text="0,00 м" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="summary-line" picking-mode="Ignore">
                    <ui:Label name="best-label" class="summary-key" text="Лучшее" picking-mode="Ignore" />
                    <ui:Label name="summary-best" class="summary-value" text="0,00 м" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="points-line" class="summary-line" picking-mode="Ignore">
                    <ui:Label name="points-label" class="summary-key" text="Очки" picking-mode="Ignore" />
                    <ui:Label name="summary-points" class="summary-value" text="0" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="summary-record" class="summary-record" text="НОВЫЙ РЕКОРД!" picking-mode="Ignore" />
                <ui:Button name="retry" class="btn" text="ЕЩЁ РАЗ" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

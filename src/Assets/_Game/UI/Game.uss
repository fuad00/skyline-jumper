/* Stickman Jumper runtime UI in the original's style: pale-blue panels with a thick navy outline on graph paper.
   Landscape reference canvas 1920 x 1080 (PanelSettings: scale with screen size, Expand). Font: PT Sans Bold (OFL, close to the original Myriad). */

.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("../Fonts/PTSans-Bold.ttf");
    color: rgb(16, 28, 48);
}

.grow {
    flex-grow: 1;
}

/* ---------- panels (plates are drawn in code: Plate.Dress) ---------- */

.panel {
    margin: 0 0 0 16px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.icon {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(16, 16, 18);
}

.icon--big {
    width: 66px;
    height: 66px;
}

/* dark «screen» inside a HUD panel: white frame, like the original's timer and wind readouts */
.lcd {
    background-color: rgb(35, 31, 32);
    border-width: 4px;
    border-color: rgb(255, 255, 255);
    border-radius: 14px;
}

/* ---------- HUD ---------- */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    flex-direction: row;
    align-items: flex-start;
    padding: 24px 28px 0 28px;
}

.minimap {
    width: 210px;
    height: 300px;
}

.wind-panel {
    height: 112px;
    padding: 16px;
}

.wind-lcd {
    width: 250px;
    flex-grow: 1;
    padding: 2px 16px 0 16px;
    justify-content: center;
}

.wind-caption {
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin: 0 0 4px 0;
    padding: 0;
}

.wind-track {
    height: 22px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    padding: 2px;
    flex-direction: row;
}

.wind-fill {
    height: 100%;
    width: 50%;
    background-color: rgb(255, 255, 255);
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.wind-arrow {
    width: 22px;
    height: 22px;
    margin-right: -2px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(35, 31, 32);
}

.time-panel {
    height: 112px;
    flex-direction: row;
    align-items: center;
    padding: 0 16px 0 14px;
}

.clock-slot {
    width: 84px;
    height: 84px;
}

.clock {
    width: 84px;
    height: 84px;
}

.time-lcd {
    width: 250px;
    height: 80px;
    margin-left: 10px;
    justify-content: center;
}

.time-text {
    font-size: 56px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    letter-spacing: 6px;
}

.time-text--low {
    color: rgb(255, 110, 100);
}

.btn-square {
    width: 112px;
    height: 112px;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.btn-square:hover, .btn-square:active, .btn-square:focus {
    background-color: rgba(0, 0, 0, 0);
}

.btn-square--on .icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* ---------- hint ---------- */

.hint-box {
    position: absolute;
    bottom: 40px;
    align-self: center;
    padding: 16px 44px;
}

.hint {
    font-size: 44px;
    color: rgb(16, 16, 18);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* ---------- screens & the original's bottom bar ---------- */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen--dim {
    background-color: rgba(16, 28, 48, 0.32);
    align-items: center;
}

.bar {
    position: absolute;
    left: 50%;
    bottom: -34px;
    width: 1650px;
    max-width: 96%;
    height: 230px;
    translate: -50% 0;
    flex-direction: row;
    padding: 22px 22px 56px 22px;
}

/* Like the original's button frame: 5 equal cells, each about twice as wide as tall, the whole bar centred
   (the original frame is 472 x 63 pt on a 568 x 320 screen). Button height 152 px, slant 0.22 x 152 = 33 px,
   gap 12 px between neighbours: margin = gap - slant. Label sizes are set in code (SlantButton) and shrink to fit. */
.slant {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 -21px 0 0;
    padding: 4px 40px 0 58px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: flex-start;
}

.slant--first {
    padding-left: 30px;
}

.slant--last {
    margin-right: 0;
    padding-right: 26px;
}

.slant:hover, .slant:active, .slant:focus, .slant:disabled {
    background-color: rgba(0, 0, 0, 0);
    opacity: 1;
}

.slant-small {
    color: rgb(255, 255, 255);
    white-space: nowrap;
    margin: 0 0 -12px 2px;
    padding: 0;
    text-shadow: 0 2px 2px rgba(0, 0, 0, 0.25);
}

.slant-big {
    color: rgb(255, 255, 255);
    white-space: nowrap;
    margin: 0;
    padding: 0;
    text-shadow: 0 3px 3px rgba(0, 0, 0, 0.3);
}

/* ---------- stickers (logo and headings): dark letters in a fat light-blue outline ---------- */

.sticker {
    font-size: 150px;
    color: rgb(35, 31, 32);
    -unity-text-outline-width: 10px;
    -unity-text-outline-color: rgb(134, 199, 221);
    text-shadow: 0 8px 10px rgba(0, 0, 0, 0.3);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.sticker--small {
    font-size: 96px;
    margin-bottom: -46px;
}

.sticker--logo {
    font-size: 170px;
}

.logo {
    position: absolute;
    right: 70px;
    top: 40px;
    align-items: flex-start;
}

.heading {
    position: absolute;
    left: 60px;
    top: 26px;
    flex-direction: row;
    align-items: flex-end;
}

.heading .sticker--small {
    margin: 0 18px 30px 0;
}

.heading--center {
    position: relative;
    left: 0;
    top: 0;
    margin-top: 300px;
}

/* ---------- stage cards (original «pack» frame: black outline, white rim, dark logo, blue bottom) ---------- */

.stage-cards {
    position: absolute;
    left: 0;
    right: 0;
    top: 230px;
    height: 540px;
    overflow: hidden;
}

/* the strip of all stage cards; GameUI slides it so the chosen card is centred (step 680 px = card + margins) */
.stage-track {
    position: absolute;
    left: 0;
    top: 20px;
    flex-direction: row;
}

.stage-card {
    width: 620px;
    height: 500px;
    margin: 0 30px;
    padding: 13px;
    flex-shrink: 0;
    transform-origin: center;
}

.stage-head {
    height: 250px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    background-color: rgb(35, 31, 32);
    flex-direction: row;
    align-items: center;
    padding: 0 26px;
    overflow: hidden;
}

/* city silhouette along the bottom of the stage logo, like the original's pack logos */
.stage-skyline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 300px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(150, 150, 156);
}

.stage-number {
    font-size: 180px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 8px;
    -unity-text-outline-color: rgb(134, 199, 221);
    margin: 0 4px 0 0;
    padding: 0;
}

.stage-word {
    font-size: 60px;
    color: rgb(35, 31, 32);
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: rgb(134, 199, 221);
    margin: 70px 0 0 -6px;
    padding: 0;
}

.stage-texts {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: flex-end;
    justify-content: center;
    margin-left: 12px;
}

.stage-title {
    font-size: 58px;
    color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-right;
}

.stage-sub {
    font-size: 32px;
    color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-text-align: middle-right;
}

.stage-foot {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.stage-star {
    width: 120px;
    height: 120px;
    margin-right: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.stage-count {
    font-size: 100px;
    color: rgb(35, 31, 32);
    margin: 0;
    padding: 0;
}

.stage-lock {
    position: absolute;
    left: 13px;
    top: 13px;
    right: 13px;
    bottom: 13px;
    border-radius: 20px;
    background-color: rgba(35, 31, 32, 0.6);
    align-items: center;
    justify-content: center;
    padding-top: 150px;
}

.lock-icon {
    width: 170px;
    height: 170px;
    -unity-background-scale-mode: scale-to-fit;
}

.lock-text {
    font-size: 44px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin: 6px 0 0 0;
    padding: 0;
    text-shadow: 0 3px 2px rgba(0, 0, 0, 0.6);
}

/* ---------- level select ---------- */

.stage-badge {
    position: absolute;
    right: 50px;
    top: 40px;
    width: 600px;
    height: 190px;
    padding: 14px;
}

.stage-badge-inner {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding: 0 22px;
    overflow: hidden;
}

.stage-badge .stage-number {
    font-size: 130px;
}

.stage-badge .stage-word {
    font-size: 50px;
    margin-top: 44px;
}

.stage-badge .stage-title {
    font-size: 52px;
}

.stage-badge .stage-sub {
    font-size: 30px;
}

.level-grid {
    position: absolute;
    left: 200px;
    right: 200px;
    top: 280px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.level-node {
    width: 240px;
    height: 240px;
    margin: 12px 20px;
    padding: 10px;
}

.node-top {
    height: 62px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    background-color: rgb(35, 31, 32);
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.node-body {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.node-star {
    width: 46px;
    height: 46px;
    margin: 0 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.node-number {
    font-size: 96px;
    color: rgb(35, 31, 32);
    margin: -6px 0 -10px 0;
    padding: 0;
}

.node-points {
    font-size: 30px;
    color: rgb(35, 31, 32);
    margin: 0;
    padding: 0;
}

.node-lock {
    position: absolute;
    right: -28px;
    bottom: -22px;
    width: 110px;
    height: 110px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------- jump summary (original: dark card with white rim, red «total POINTS» plate) ---------- */

.summary-card {
    width: 720px;
    margin-top: 40px;
    padding: 34px 50px 40px 50px;
}

.summary-title {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.summary-face {
    width: 120px;
    height: 120px;
    margin-right: 18px;
    -unity-background-scale-mode: scale-to-fit;
}

.summary-title-small {
    font-size: 46px;
    color: rgb(255, 255, 255);
    margin: 0 0 -18px 0;
    padding: 0;
}

.summary-title-big {
    font-size: 92px;
    color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
}

.summary-level {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin: 6px 0 14px 0;
}

.summary-line {
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 10px;
}

.summary-key {
    font-size: 44px;
    color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
}

.summary-value {
    font-size: 44px;
    color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
}

.stars {
    flex-direction: row;
    justify-content: flex-start;
    margin: 10px 0 4px 6px;
}

.star {
    width: 72px;
    height: 72px;
    margin: 0 8px 0 0;
    -unity-background-scale-mode: scale-to-fit;
}

.summary-record {
    font-size: 36px;
    -unity-text-align: middle-left;
    color: rgb(120, 220, 120);
    margin: 0 0 4px 10px;
}

.points-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 14px -24px -14px -24px;
    padding: 16px 40px 14px 40px;
}

.points-small {
    font-size: 36px;
    color: rgb(255, 255, 255);
    margin: 0 0 -14px 0;
    padding: 0;
}

.points-big {
    font-size: 62px;
    color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
}

.points-value {
    font-size: 82px;
    color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
}

/* ---------- dialog («are you sure?», map builder stub): dark card like the summary, buttons below ---------- */

.dialog {
    justify-content: center;
}

.dialog-card {
    width: 1080px;
    margin-bottom: 90px;
    padding: 50px 60px 44px 60px;
    align-items: center;
}

.dialog-title {
    font-size: 88px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin: 0 0 10px 0;
    padding: 0;
}

.dialog-text {
    font-size: 40px;
    color: rgb(196, 230, 244);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 0 40px 0;
    padding: 0;
}

.dialog-bar {
    flex-direction: row;
    height: 152px;
}

.dialog-bar .slant {
    flex-grow: 0;
    flex-basis: auto;
    width: 340px;
}
